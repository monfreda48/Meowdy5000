{
  "java.import.gradle.enabled": false,
  "java.project.importOnFirstTimeStartup": "disabled",
  "java.autobuild.enabled": false,
  "java.showBuildStatusOnStart": "off",
  "java.diagnostics.filter": [
    "*"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  }
}
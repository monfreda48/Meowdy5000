{
  "java.import.gradle.enabled": false,
  "java.project.importOnFirstTimeStartup": "disabled",
  "java.autobuild.enabled": false,
  "java.showBuildStatusOnStart": "off",
  "java.diagnostics.filter": [
    "*"
  ],
  "capacitor.androidDirectory": "frontend/android",
  "capacitor.android.projectDirectory": "frontend/android",
  "capacitor.apkPath": "frontend/android/app/build/outputs/apk/debug/app-debug.apk",
  "capacitor.android.apkPath": "frontend/android/app/build/outputs/apk/debug/app-debug.apk",
  "android.apkPath": "frontend/android/app/build/outputs/apk/debug/app-debug.apk",
  "ionic.androidApkPath": "frontend/android/app/build/outputs/apk/debug/app-debug.apk",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "java.configuration.updateBuildConfiguration": "automatic"
}
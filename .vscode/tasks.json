{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Check Devices",
      "type": "shell",
      "command": "adb devices",
      "problemMatcher": []
    },
    {
      "label": "Android: Build & Install",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/frontend/android"
      },
      "command": ".\\gradlew.bat installDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Launch App",
      "type": "shell",
      "command": "adb shell am start -n com.meowdy5000.stattracker/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Android: Stream App Logs",
      "type": "shell",
      "command": "adb logcat *:E",
      "problemMatcher": []
    },
    {
      "label": "Android: Capture Screenshot",
      "type": "shell",
      "command": "adb shell screencap -p /sdcard/screen.png; adb pull /sdcard/screen.png ./debug_screen.png",
      "problemMatcher": []
    }
  ]
}
